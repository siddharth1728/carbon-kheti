# Carbon Kheti FastAPI Backend Environment Configuration
PROJECT_NAME="Carbon Kheti MRV API"
API_V1_STR="/api/v1"
SECRET_KEY="demo-super-secret-jwt-key-carbon-kheti-telangana-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
MIN_SUPPORTED_APP_VERSION="1.0.0"
